{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "incisoria-assistente-timbri",
  "account_id": "e324d0c0be2f6bd77ea7037db05d0d57",
  "main": "cloudflare/index.ts",
  "compatibility_date": "2026-11-06",
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": ".local/storefront-dist", "binding": "ASSETS", "run_worker_first": true },
  "durable_objects": { "bindings": [{ "name": "ASSISTANT", "class_name": "AssistantStore" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AssistantStore"] }],
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": { "AI_GLOBAL_BUDGET_USD": "1" },
  "observability": { "enabled": false }
}
