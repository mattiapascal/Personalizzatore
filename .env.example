# Copiare in .env.local, escluso da Git. Riavviare npm run dev dopo modifiche.
# demo = parser esplicito; openai = provider reale, mai fallback automatico al parser.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini-2026-03-17
# USD, listino standard. Massimale prudente del collaudo autorizzato (tetto utente 2 EUR).
AI_BUDGET_USD=1
AI_MAX_REQUESTS=100
# false: nessun blocco cumulativo locale; usa i limiti configurati nell'account OpenAI.
# I limiti di frequenza e dimensione della singola richiesta restano attivi.
AI_ENFORCE_LOCAL_LIMITS=true
# Attivare soltanto dopo consenso esplicito all'invio di un sottoinsieme dei dati catalogo a OpenAI.
AI_SHARE_CATALOG_CONTEXT=false
# Tetto per conversazione, indipendente dal contatore cumulativo informativo.
AI_SESSION_BUDGET_USD=0.05

# Accesso Admin read_products; nessun segreto nel frontend/VITE_*.
SHOPIFY_SHOP_DOMAIN=zqu2eg-72.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=
# Ambito esplicito: non garantisce che ogni timbro sia nominato in questo modo.
SHOPIFY_CATALOG_QUERY=title:timbr*
CATALOG_POLL_SECONDS=300
