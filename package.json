{
  "name": "shopify-ai-customizer-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.17.0 <25" },
  "scripts": {
    "assistant:generate": "node --import tsx scripts/compile-assistant-policy.ts",
    "assistant:check": "node --import tsx scripts/compile-assistant-policy.ts --check",
    "predev": "npm run assistant:generate",
    "prebuild": "npm run assistant:check",
    "pretest": "npm run assistant:check",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "schemas": "node --import tsx scripts/export-schemas.ts",
    "fixtures:editor": "node --import tsx scripts/export-editor-fixture.ts",
    "capture:lab": "node --import tsx scripts/capture-lab.ts",
    "capture:mounts": "node --import tsx scripts/capture-mounts.ts",
    "capture:chat": "node --import tsx scripts/capture-chat-layout.ts",
    "capture:privacy": "node --import tsx scripts/capture-privacy.ts",
    "catalog:audit": "node --import tsx scripts/audit-mounts.ts",
    "fixtures:mounts": "node --import tsx scripts/export-mount-fixtures.ts",
    "eval:ai": "node --import tsx scripts/eval-ai.ts",
    "eval:chat": "node --import tsx scripts/eval-chat-ai.ts",
    "eval:loyalty": "node --import tsx scripts/eval-loyalty-chat.ts",
    "eval:privacy": "node --import tsx scripts/eval-private-context.ts",
    "check:secrets": "node --import tsx scripts/check-client-secrets.ts",
    "check": "npm test && npm run build && npm run check:secrets && npm run test:e2e"
  },
  "dependencies": { "fabric": "7.4.0", "react": "19.3.1", "react-dom": "19.3.1", "zod": "4.6.7" },
  "devDependencies": { "@playwright/test": "1.64.1", "@types/node": "22.20.5", "@types/react": "19.3.0", "@types/react-dom": "19.3.0", "@vitejs/plugin-react": "6.2.1", "tsx": "4.23.15", "typescript": "7.0.2", "vite": "8.3.6", "vitest": "5.1.0" }
}
