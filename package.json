{
  "name": "shopify-ai-customizer-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.17.0 <25"
  },
  "scripts": {
    "assistant:generate": "node --import tsx scripts/compile-assistant-policy.ts && node --import tsx scripts/compile-store-knowledge.ts",
    "assistant:check": "node --import tsx scripts/compile-assistant-policy.ts --check && node --import tsx scripts/compile-store-knowledge.ts --check",
    "predev": "npm run assistant:generate",
    "prebuild": "npm run assistant:check",
    "pretest": "npm run assistant:check",
    "dev": "node --max-old-space-size=4096 node_modules/vite/bin/vite.js --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "build:storefront": "npm run assistant:check && tsc --noEmit && tsc --noEmit -p tsconfig.worker.json && vite build --config vite.storefront.config.ts",
    "worker:dev": "WRANGLER_LOG_PATH=.local/wrangler-logs WRANGLER_SEND_METRICS=false wrangler dev --local --persist-to .local/worker-state",
    "worker:package": "npm run build:storefront && WRANGLER_LOG_PATH=.local/wrangler-logs WRANGLER_SEND_METRICS=false wrangler deploy --dry-run --outdir .local/worker-package",
    "worker:deploy": "npm run worker:package && WRANGLER_LOG_PATH=.local/wrangler-logs WRANGLER_SEND_METRICS=false wrangler deploy",
    "test:worker": "node --import tsx scripts/test-worker.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:storefront": "playwright test --config playwright.storefront.config.ts",
    "schemas": "node --import tsx scripts/export-schemas.ts",
    "fixtures:editor": "node --import tsx scripts/export-editor-fixture.ts",
    "capture:lab": "node --import tsx scripts/capture-lab.ts",
    "capture:selection": "node --import tsx scripts/capture-editor-selection.ts",
    "capture:inspector": "node --import tsx scripts/capture-editor-inspector.ts",
    "capture:editor": "node --import tsx scripts/capture-editor-objects.ts",
    "capture:mounts": "node --import tsx scripts/capture-mounts.ts",
    "capture:chat": "node --import tsx scripts/capture-chat-layout.ts",
    "capture:privacy": "node --import tsx scripts/capture-privacy.ts",
    "catalog:audit": "node --import tsx scripts/audit-mounts.ts",
    "fixtures:mounts": "node --import tsx scripts/export-mount-fixtures.ts",
    "eval:ai": "node --import tsx scripts/eval-ai.ts",
    "eval:chat": "node --import tsx scripts/eval-chat-ai.ts",
    "eval:loyalty": "node --import tsx scripts/eval-loyalty-chat.ts",
    "eval:privacy": "node --import tsx scripts/eval-private-context.ts",
    "check:secrets": "node --import tsx scripts/check-client-secrets.ts",
    "check:public-secrets": "node --import tsx scripts/check-client-secrets.ts .local/storefront-dist",
    "check:release": "npm run check && npm run worker:package && npm run test:worker && npm run test:storefront && npm run check:public-secrets",
    "check": "npm test && npm run build && npm run check:secrets && npm run test:e2e",
    "eval:knowledge": "node --import tsx scripts/eval-store-knowledge.ts",
    "editor:collaudo": "node --import tsx scripts/export-editor-acceptance.ts",
    "pitchprint:fonts": "node --import tsx scripts/pitchprint-font-inventory.ts",
    "editor:storage": "node --max-old-space-size=6144 --import tsx scripts/editor-archive-storage.ts",
    "editor:storage-trial": "vite --config vite.storage-trial.config.ts --host 127.0.0.1"
  },
  "dependencies": {
    "fabric": "7.4.0",
    "htmlparser2": "12.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261106.1",
    "@playwright/test": "1.64.1",
    "@types/clipper-lib": "6.4.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "clipper-lib": "6.4.2",
    "miniflare": "5.20261104.0-beta",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "wrangler": "4.158.0",
    "sharp": "0.35.5"
  }
}
