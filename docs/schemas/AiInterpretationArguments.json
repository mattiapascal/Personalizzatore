{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "dialogueAct": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "answer",
            "off_topic",
            "unclear",
            "help"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "contentText": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 480
        },
        {
          "type": "null"
        }
      ]
    },
    "contentKind": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "text",
            "graphic",
            "mixed"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "purpose": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "business",
            "exlibris",
            "loyalty",
            "general"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "graphicSubject": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        {
          "type": "null"
        }
      ]
    },
    "family": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "stamp",
            "other"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "mechanism": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "automatic",
            "manual",
            "pocket",
            "emboss"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "material": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "wood",
            "plastic",
            "metal",
            "any"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "shape": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "rectangle",
            "square",
            "round"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "diameterMm": {
      "anyOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        },
        {
          "type": "null"
        }
      ]
    },
    "lines": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        {
          "type": "null"
        }
      ]
    },
    "hasLogo": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "widthMm": {
      "anyOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        },
        {
          "type": "null"
        }
      ],
      "description": "Larghezza minima richiesta in millimetri; convertire i cm moltiplicando per 10, senza chiedere al cliente di convertirli."
    },
    "heightMm": {
      "anyOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        },
        {
          "type": "null"
        }
      ],
      "description": "Altezza minima richiesta in millimetri; convertire i cm moltiplicando per 10."
    },
    "sizeUnknown": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "clearFields": {
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "family",
          "mechanism",
          "material",
          "shape",
          "diameterMm",
          "lines",
          "hasLogo",
          "minimumAreaMm",
          "sizeUnknown",
          "sizeIsEstimate"
        ]
      }
    },
    "clarification": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "dialogueAct",
    "contentText",
    "contentKind",
    "purpose",
    "graphicSubject",
    "family",
    "mechanism",
    "material",
    "shape",
    "diameterMm",
    "lines",
    "hasLogo",
    "widthMm",
    "heightMm",
    "sizeUnknown",
    "clearFields",
    "clarification"
  ],
  "additionalProperties": false
}
