{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "dialogueAct": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "answer",
            "off_topic",
            "unclear",
            "help",
            "information"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "storeQuery": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        {
          "type": "null"
        }
      ],
      "description": "Ricerca semantica espansa per domande informative su prodotti, FAQ o negozio; include prodotto, sinonimi e contesto pertinente."
    },
    "storeScope": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "store",
            "product"
          ]
        },
        {
          "type": "null"
        }
      ],
      "description": "store per spedizioni, pagamenti, ordini, procedure file e servizi generali; product per informazioni su un articolo o famiglia di prodotti."
    },
    "useStoreReferences": {
      "description": "true per domande di seguito sul prodotto già citato; false se viene nominato un nuovo prodotto o si cambia argomento.",
      "type": [
        "boolean",
        "null"
      ]
    },
    "helpTopic": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "mechanism",
            "shape",
            "dimensions",
            "content",
            "material",
            "catalog"
          ]
        },
        {
          "type": "null"
        }
      ],
      "description": "Solo per spiegazioni sui timbri; nessuna risposta generale."
    },
    "changeIntent": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "update",
            "withdraw"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "clearEvidence": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        {
          "type": "null"
        }
      ]
    },
    "contentText": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 480
        },
        {
          "type": "null"
        }
      ]
    },
    "contentKind": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "text",
            "graphic",
            "mixed"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "purpose": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "business",
            "exlibris",
            "loyalty",
            "general"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "graphicSubject": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        {
          "type": "null"
        }
      ]
    },
    "family": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "stamp",
            "other"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "mechanism": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "automatic",
            "manual",
            "pocket",
            "emboss"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "material": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "wood",
            "plastic",
            "metal",
            "any"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "shape": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "rectangle",
            "square",
            "round"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "diameterMm": {
      "anyOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        },
        {
          "type": "null"
        }
      ]
    },
    "lines": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        {
          "type": "null"
        }
      ]
    },
    "hasLogo": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "widthMm": {
      "anyOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        },
        {
          "type": "null"
        }
      ],
      "description": "Larghezza minima richiesta in millimetri; convertire i cm moltiplicando per 10, senza chiedere al cliente di convertirli."
    },
    "heightMm": {
      "anyOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        },
        {
          "type": "null"
        }
      ],
      "description": "Altezza minima richiesta in millimetri; convertire i cm moltiplicando per 10."
    },
    "targetWidthMm": {
      "anyOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        },
        {
          "type": "null"
        }
      ]
    },
    "targetHeightMm": {
      "anyOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        },
        {
          "type": "null"
        }
      ]
    },
    "sizeUnknown": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "clearFields": {
      "maxItems": 11,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "family",
          "mechanism",
          "material",
          "shape",
          "diameterMm",
          "lines",
          "hasLogo",
          "minimumAreaMm",
          "maximumAreaMm",
          "sizeUnknown",
          "sizeIsEstimate"
        ]
      }
    },
    "clarification": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "dialogueAct",
    "storeQuery",
    "storeScope",
    "useStoreReferences",
    "helpTopic",
    "changeIntent",
    "clearEvidence",
    "contentText",
    "contentKind",
    "purpose",
    "graphicSubject",
    "family",
    "mechanism",
    "material",
    "shape",
    "diameterMm",
    "lines",
    "hasLogo",
    "widthMm",
    "heightMm",
    "targetWidthMm",
    "targetHeightMm",
    "sizeUnknown",
    "clearFields",
    "clarification"
  ],
  "additionalProperties": false
}
