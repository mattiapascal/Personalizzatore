{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "documentId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "productId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^gid:\\/\\/shopify\\/Product\\/\\d+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "variantId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^gid:\\/\\/shopify\\/ProductVariant\\/\\d+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "catalogVersion": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "catalogProductProfileVersion": {
      "default": null,
      "anyOf": [
        {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "productProfileVersion": {
      "type": "string",
      "const": "TEST-stamp-v1"
    },
    "fixture": {
      "type": "boolean",
      "const": true
    },
    "validatedForProduction": {
      "type": "boolean",
      "const": false
    },
    "areaMm": {
      "type": "object",
      "properties": {
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        }
      },
      "required": [
        "width",
        "height"
      ],
      "additionalProperties": false
    },
    "shape": {
      "default": "rectangle",
      "type": "string",
      "enum": [
        "rectangle",
        "square",
        "round"
      ]
    },
    "objects": {
      "minItems": 1,
      "maxItems": 30,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9-]{0,63}$"
              },
              "type": {
                "type": "string",
                "const": "text"
              },
              "xMm": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000
              },
              "yMm": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 480
              },
              "fontSizePt": {
                "type": "number",
                "minimum": 7,
                "maximum": 48
              },
              "fontFamily": {
                "type": "string",
                "const": "Arial"
              },
              "fill": {
                "type": "string",
                "enum": [
                  "#000000",
                  "#ffffff"
                ]
              }
            },
            "required": [
              "id",
              "type",
              "xMm",
              "yMm",
              "text",
              "fontSizePt",
              "fontFamily",
              "fill"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9-]{0,63}$"
              },
              "type": {
                "type": "string",
                "const": "rect"
              },
              "xMm": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000
              },
              "yMm": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000
              },
              "widthMm": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1000
              },
              "heightMm": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1000
              },
              "strokeMm": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 2
              },
              "stroke": {
                "type": "string",
                "enum": [
                  "#000000",
                  "#ffffff"
                ]
              }
            },
            "required": [
              "id",
              "type",
              "xMm",
              "yMm",
              "widthMm",
              "heightMm",
              "strokeMm",
              "stroke"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9-]{0,63}$"
              },
              "type": {
                "type": "string",
                "const": "circle"
              },
              "xMm": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000
              },
              "yMm": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000
              },
              "radiusMm": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 500
              },
              "strokeMm": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 2
              },
              "stroke": {
                "type": "string",
                "enum": [
                  "#000000",
                  "#ffffff"
                ]
              }
            },
            "required": [
              "id",
              "type",
              "xMm",
              "yMm",
              "radiusMm",
              "strokeMm",
              "stroke"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "documentId",
    "revision",
    "productId",
    "variantId",
    "catalogVersion",
    "catalogProductProfileVersion",
    "productProfileVersion",
    "fixture",
    "validatedForProduction",
    "areaMm",
    "shape",
    "objects"
  ],
  "additionalProperties": false
}
