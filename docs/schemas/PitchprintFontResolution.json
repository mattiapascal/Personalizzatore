{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "const": "pitchprint-font-resolution"
    },
    "requested": {
      "type": "object",
      "properties": {
        "family": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "weight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "italic": {
          "type": "boolean"
        }
      },
      "required": [
        "family",
        "weight",
        "italic"
      ],
      "additionalProperties": false
    },
    "asset": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^font-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "familyGroup": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "styleName": {
          "type": "string",
          "maxLength": 120
        },
        "weight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "italic": {
          "type": "boolean"
        },
        "family": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "format": {
          "type": "string",
          "enum": [
            "ttf",
            "otf",
            "woff",
            "woff2"
          ]
        },
        "dataBase64": {
          "type": "string",
          "maxLength": 1400000
        },
        "licenseText": {
          "type": "string",
          "maxLength": 30000
        },
        "sourceUrl": {
          "type": "string",
          "maxLength": 1000
        }
      },
      "required": [
        "id",
        "weight",
        "italic",
        "family",
        "format",
        "dataBase64"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "file-metadata"
            },
            "declaredNames": {
              "minItems": 1,
              "maxItems": 3,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "kind",
            "declaredNames",
            "sha256"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "original-catalog"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "catalogFamily": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          },
          "required": [
            "kind",
            "sha256",
            "catalogFamily"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "kind",
    "requested",
    "asset",
    "evidence"
  ],
  "additionalProperties": false
}
