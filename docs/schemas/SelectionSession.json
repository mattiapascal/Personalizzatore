{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "sessionId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "requirements": {
      "type": "object",
      "properties": {
        "family": {
          "type": "string",
          "enum": [
            "stamp",
            "other"
          ]
        },
        "mechanism": {
          "type": "string",
          "enum": [
            "automatic",
            "manual",
            "pocket",
            "emboss"
          ]
        },
        "shape": {
          "type": "string",
          "enum": [
            "rectangle",
            "square",
            "round"
          ]
        },
        "material": {
          "type": "string",
          "enum": [
            "wood",
            "plastic",
            "metal",
            "any"
          ]
        },
        "diameterMm": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1000
            },
            {
              "type": "null"
            }
          ]
        },
        "lines": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "hasLogo": {
          "type": "boolean"
        },
        "minimumAreaMm": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "width": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1000
                },
                "height": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1000
                }
              },
              "required": [
                "width",
                "height"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "sizeUnknown": {
          "type": "boolean"
        },
        "sizeIsEstimate": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "string"
          },
          "profileId": {
            "type": "string"
          },
          "profileVersion": {
            "type": "number",
            "const": 1
          },
          "catalogVersion": {
            "type": "string"
          },
          "reasons": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "ruleId": {
                  "type": "string"
                },
                "explanation": {
                  "type": "string"
                }
              },
              "required": [
                "ruleId",
                "explanation"
              ],
              "additionalProperties": false
            }
          },
          "pending": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "productId",
          "profileVersion",
          "catalogVersion",
          "reasons",
          "pending"
        ],
        "additionalProperties": false
      }
    },
    "selectedProductId": {
      "type": [
        "string",
        "null"
      ]
    },
    "selectedProfileId": {
      "type": [
        "string",
        "null"
      ]
    },
    "catalogVersion": {
      "type": "string"
    },
    "updatedAt": {
      "type": "number"
    }
  },
  "required": [
    "schemaVersion",
    "sessionId",
    "revision",
    "requirements",
    "candidates",
    "selectedProductId",
    "catalogVersion",
    "updatedAt"
  ],
  "additionalProperties": false
}
