{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "sessionId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "requirements": {
      "type": "object",
      "properties": {
        "family": {
          "type": "string",
          "enum": [
            "stamp",
            "other"
          ]
        },
        "mechanism": {
          "type": "string",
          "enum": [
            "automatic",
            "manual",
            "pocket"
          ]
        },
        "shape": {
          "type": "string",
          "enum": [
            "rectangle",
            "round"
          ]
        },
        "lines": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "hasLogo": {
          "type": "boolean"
        },
        "minimumAreaMm": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "width": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1000
                },
                "height": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1000
                }
              },
              "required": [
                "width",
                "height"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "sizeUnknown": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "lastQuestion": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 300
        },
        {
          "type": "null"
        }
      ]
    },
    "recentMessages": {
      "default": [],
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ]
          },
          "text": {
            "type": "string",
            "maxLength": 400
          }
        },
        "required": [
          "role",
          "text"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "message",
    "sessionId",
    "revision",
    "requirements",
    "lastQuestion",
    "recentMessages"
  ],
  "additionalProperties": false
}
