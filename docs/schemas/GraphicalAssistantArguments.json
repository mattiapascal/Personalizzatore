{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "clarification": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        {
          "type": "null"
        }
      ]
    },
    "actions": {
      "maxItems": 16,
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "addText"
                ]
              },
              "text": {
                "type": "string",
                "maxLength": 4000
              },
              "fontId": {
                "type": "string",
                "pattern": "^[ofi][1-9]\\d{0,3}$"
              },
              "fontSizePt": {
                "type": "number",
                "minimum": 0.1,
                "maximum": 2000
              },
              "fill": {
                "type": "string",
                "pattern": "^#[0-9a-f]{6}$"
              },
              "alignment": {
                "type": "string",
                "enum": [
                  "left",
                  "center",
                  "right"
                ]
              },
              "xMm": {
                "type": "number",
                "minimum": -10000,
                "maximum": 10000
              },
              "yMm": {
                "type": "number",
                "minimum": -10000,
                "maximum": 10000
              },
              "widthMm": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 10000
              }
            },
            "required": [
              "type",
              "text",
              "fontId",
              "fontSizePt",
              "fill",
              "alignment",
              "xMm",
              "yMm",
              "widthMm"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "editText"
                ]
              },
              "objectId": {
                "type": "string",
                "pattern": "^[ofi][1-9]\\d{0,3}$"
              },
              "text": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 4000
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "fontId": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[ofi][1-9]\\d{0,3}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "fontSizePt": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0.1,
                    "maximum": 2000
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "fill": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^#[0-9a-f]{6}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "alignment": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "left",
                      "center",
                      "right"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "type",
              "objectId",
              "text",
              "fontId",
              "fontSizePt",
              "fill",
              "alignment"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "moveObject"
                ]
              },
              "objectId": {
                "type": "string",
                "pattern": "^[ofi][1-9]\\d{0,3}$"
              },
              "xMm": {
                "type": "number",
                "minimum": -10000,
                "maximum": 10000
              },
              "yMm": {
                "type": "number",
                "minimum": -10000,
                "maximum": 10000
              }
            },
            "required": [
              "type",
              "objectId",
              "xMm",
              "yMm"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "addImage"
                ]
              },
              "imageId": {
                "type": "string",
                "pattern": "^[ofi][1-9]\\d{0,3}$"
              },
              "xMm": {
                "type": "number",
                "minimum": -10000,
                "maximum": 10000
              },
              "yMm": {
                "type": "number",
                "minimum": -10000,
                "maximum": 10000
              },
              "widthMm": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 10000
              }
            },
            "required": [
              "type",
              "imageId",
              "xMm",
              "yMm",
              "widthMm"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "clarification",
    "actions"
  ],
  "additionalProperties": false
}
