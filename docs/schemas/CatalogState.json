{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "fixture": {
          "type": "boolean"
        },
        "source": {
          "type": "string"
        },
        "capturedOn": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        "shopDomain": {
          "type": "string",
          "const": "www.incisoriasacchetti.it"
        },
        "products": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "profileId": {
                "type": "string"
              },
              "variantLabel": {
                "type": "string"
              },
              "productId": {
                "type": "string",
                "pattern": "^gid:\\/\\/shopify\\/Product\\/\\d+$"
              },
              "variantIds": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^gid:\\/\\/shopify\\/ProductVariant\\/\\d+$"
                }
              },
              "handle": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "enum": [
                  "ACTIVE",
                  "ARCHIVED",
                  "DRAFT"
                ]
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "profileVersion": {
                "type": "number",
                "const": 1
              },
              "family": {
                "type": "string",
                "const": "stamp"
              },
              "mechanism": {
                "type": "string",
                "enum": [
                  "automatic",
                  "manual",
                  "pocket",
                  "emboss"
                ]
              },
              "shape": {
                "type": "string",
                "enum": [
                  "rectangle",
                  "square",
                  "round"
                ]
              },
              "nominalAreaMm": {
                "type": "object",
                "properties": {
                  "width": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 1000
                  },
                  "height": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 1000
                  }
                },
                "required": [
                  "width",
                  "height"
                ],
                "additionalProperties": false
              },
              "materials": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "wood",
                    "plastic",
                    "metal"
                  ]
                }
              },
              "mechanismSource": {
                "type": "string"
              },
              "areaSource": {
                "type": "string"
              },
              "dataWarnings": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "supportsLogo": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "logoSource": {
                "type": "string"
              },
              "constraints": {
                "type": "object",
                "properties": {
                  "minFontSizePt": {
                    "anyOf": [
                      {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "safeMarginMm": {
                    "anyOf": [
                      {
                        "type": "number",
                        "minimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "allowedColors": {
                    "anyOf": [
                      {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "minFontSizePt",
                  "safeMarginMm",
                  "allowedColors"
                ],
                "additionalProperties": false
              },
              "validatedForProduction": {
                "type": "boolean",
                "const": false
              },
              "price": {
                "type": "null"
              },
              "availability": {
                "type": "null"
              }
            },
            "required": [
              "productId",
              "variantIds",
              "handle",
              "title",
              "status",
              "url",
              "tags",
              "profileVersion",
              "family",
              "mechanism",
              "shape",
              "nominalAreaMm",
              "areaSource",
              "supportsLogo",
              "logoSource",
              "constraints",
              "validatedForProduction",
              "price",
              "availability"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schemaVersion",
        "fixture",
        "source",
        "capturedOn",
        "shopDomain",
        "products"
      ],
      "additionalProperties": false
    },
    "checkedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "pending": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "productId",
          "title",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "snapshot",
    "checkedAt",
    "pending"
  ],
  "additionalProperties": false
}
