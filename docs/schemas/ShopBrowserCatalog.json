{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "source": {
      "type": "string",
      "enum": [
        "shopify",
        "test"
      ]
    },
    "shopDomain": {
      "type": "string",
      "const": "zqu2eg-72.myshopify.com"
    },
    "checkedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "products": {
      "maxItems": 5000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^gid:\\/\\/shopify\\/Product\\/\\d+$"
          },
          "title": {
            "type": "string"
          },
          "handle": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "ARCHIVED",
              "DRAFT",
              "UNLISTED"
            ]
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "collectionIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^gid:\\/\\/shopify\\/Collection\\/\\d+$"
            }
          },
          "onlineStoreUrl": {
            "anyOf": [
              {
                "type": "string",
                "format": "uri"
              },
              {
                "type": "null"
              }
            ]
          },
          "image": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "alt": {
                    "type": "string"
                  }
                },
                "required": [
                  "url",
                  "alt"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "title",
          "handle",
          "status",
          "tags",
          "collectionIds",
          "onlineStoreUrl",
          "image"
        ],
        "additionalProperties": false
      }
    },
    "collections": {
      "maxItems": 5000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^gid:\\/\\/shopify\\/Collection\\/\\d+$"
          },
          "title": {
            "type": "string"
          },
          "handle": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "handle"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "source",
    "shopDomain",
    "checkedAt",
    "products",
    "collections"
  ],
  "additionalProperties": false
}
