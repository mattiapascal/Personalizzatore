{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "family": {
      "type": "string",
      "enum": [
        "stamp",
        "other"
      ]
    },
    "mechanism": {
      "type": "string",
      "enum": [
        "automatic",
        "manual",
        "pocket",
        "emboss"
      ]
    },
    "shape": {
      "type": "string",
      "enum": [
        "rectangle",
        "square",
        "round"
      ]
    },
    "material": {
      "type": "string",
      "enum": [
        "wood",
        "plastic",
        "metal",
        "any"
      ]
    },
    "diameterMm": {
      "anyOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        },
        {
          "type": "null"
        }
      ]
    },
    "lines": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30
    },
    "hasLogo": {
      "type": "boolean"
    },
    "minimumAreaMm": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "width": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1000
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1000
            }
          },
          "required": [
            "width",
            "height"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "sizeUnknown": {
      "type": "boolean"
    },
    "sizeIsEstimate": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
